{
  "title": "Loja Veloz: visão geral",
  "uid": "loja-veloz-geral",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["loja-veloz"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Serviços no ar",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(up{job=\"loja-veloz\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 4 }] } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requisições por segundo (por serviço)",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (servico) (rate(http_request_duration_seconds_count[1m]))", "legendFormat": "{{servico}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Taxa de erros 5xx",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (servico) (rate(http_request_duration_seconds_count{status=~\"5..\"}[5m])) / sum by (servico) (rate(http_request_duration_seconds_count[5m]))", "legendFormat": "{{servico}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência p95 (segundos)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, servico) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{servico}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memória (processo Node.js)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "process_resident_memory_bytes{job=\"loja-veloz\"}", "legendFormat": "{{servico}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    }
  ]
}
