# Copie para ".env" e preencha. NUNCA coloque valores reais aqui: este arquivo vai para o Git.
# O ".env" está no .gitignore.

# Banco de dados (os bancos pedidos_db e estoque_db são criados automaticamente)
DB_USER=postgres
DB_SENHA=

# Chave exigida pelo gateway nas rotas de pedidos (cabeçalho x-api-key). Mínimo 16 caracteres.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=

# Painel de monitoramento (Grafana)
GRAFANA_USUARIO=admin
GRAFANA_SENHA=

# Porta do gateway no seu computador (só localhost)
PORTA_GATEWAY=8080
